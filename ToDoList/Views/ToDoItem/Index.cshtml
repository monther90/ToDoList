@model System.Collections.Generic.IEnumerable<global::Task.Models.TodoItem>

@{
    ViewData["Title"] = "Tasks";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchDate = ViewBag.SearchDate ?? "";

    DateTime now = DateTime.Now;
}

<div class="card shadow-sm mt-4">
    <div class="card-body p-4">

        <h2 class="mb-4">TodoItem List</h2>

        <a asp-controller="TodoItem"
           asp-action="Create"
           class="btn btn-primary mb-3">
            Add New Task
        </a>

        <form asp-controller="TodoItem"
              asp-action="Index"
              method="get"
              class="d-flex flex-wrap gap-2 mb-4">

            <input type="date"
                   name="searchDate"
                   value="@searchDate"
                   class="form-control"
                   style="max-width: 220px;" />

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-controller="TodoItem"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Clear
            </a>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Deadline</th>
                        <th>File</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        bool isOverdue = item.DeadLine < now;
                        DateTime? deadline = item.DeadLine;

                        <tr>
                            <td>@item.Title</td>

                            <td style="white-space: pre-wrap;">@item.Description</td>

                            <td class="@(isOverdue ? "table-danger" : "")">
                                @(deadline?.ToString("yyyy-MM-dd HH:mm") ?? "—")

                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-2">
                                        Overdue
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.StoredFileName))
                                {
                                    <a asp-controller="TodoItem"
                                       asp-action="Download"
                                       asp-route-id="@item.Id"
                                       class="btn btn-success btn-sm">
                                        Download
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">No file</span>
                                }
                            </td>

                            <td class="text-nowrap">
                                <a asp-controller="TodoItem"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-task-id="@item.Id"
                                        data-task-title="@item.Title">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center text-muted py-4">
                                No tasks found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Task pages">
                <ul class="pagination justify-content-center">

                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-controller="TodoItem"
                               asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-searchDate="@searchDate">
                                Previous
                            </a>
                        </li>
                    }

                    @for (int i = Math.Max(1, currentPage - 2);
                          i <= Math.Min(totalPages, currentPage + 2);
                          i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               asp-controller="TodoItem"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchDate="@searchDate">
                                @i
                            </a>
                        </li>
                    }

                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-controller="TodoItem"
                               asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-searchDate="@searchDate">
                                Next
                            </a>
                        </li>
                    }

                </ul>
            </nav>
        }

    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-describedby="deleteModalDescription"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title text-danger"
                    id="deleteModalLabel">
                    Delete Confirmation
                </h5>
            </div>

            <div class="modal-body" id="deleteModalDescription">
                <p class="mb-2">Are you sure you want to delete this task?</p>

                <strong id="deleteTaskTitle"
                        class="d-block text-break"></strong>

                <p class="text-muted small mt-3 mb-0">
                    Its attachment will be deleted with it, and this action is final.
                </p>
            </div>

            <div class="modal-footer">
                <form asp-controller="TodoItem"
                      asp-action="Delete"
                      method="post"
                      class="m-0">

                    <input type="hidden"
                           name="id"
                           id="deleteTaskId" />

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        No, Cancel
                    </button>

                    <button type="submit" class="btn btn-danger">
                        Yes, Delete
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            document.getElementById('deleteTaskId').value =
                button.getAttribute('data-task-id');

            document.getElementById('deleteTaskTitle').textContent =
                button.getAttribute('data-task-title');
        });

        deleteModal.addEventListener('shown.bs.modal', function () {
            deleteModal.querySelector('[data-bs-dismiss="modal"]').focus();
        });
    </script>
}