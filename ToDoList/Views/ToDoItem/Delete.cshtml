@model global::Task.Models.TodoItem

@{
    ViewData["Title"] = "Delete Task";
}

<div class="card shadow-sm mt-4">
    <div class="card-body p-4">

        <h2 class="mb-4">Delete Task</h2>

        <div class="alert alert-danger">
            Are you sure you want to delete this task?
            Its attachment will be deleted with it, and this action is final.
        </div>

        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9"
                style="white-space: pre-wrap;">@Model.Description</dd>

            <dt class="col-sm-3">Deadline</dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(
                    model => model.DeadLine,
                    "DeadlineValue")
            </dd>

            <dt class="col-sm-3">File</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.StoredFileName))
                {
                    <a asp-controller="TodoItem"
                       asp-action="Download"
                       asp-route-id="@Model.Id">
                        @Model.FileName
                    </a>
                }
                else
                {
                    <span class="text-muted">No file attached.</span>
                }
            </dd>
        </dl>

        <form asp-controller="TodoItem"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            <input asp-for="Id" type="hidden" />

            <button type="submit" class="btn btn-danger">
                Confirm Delete
            </button>

            <a asp-controller="TodoItem"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>

    </div>
</div>